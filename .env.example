# On Neon these two must differ. DATABASE_URL is the -pooler host, which the app
# shares through PgBouncer. DIRECT_URL is the plain host, because prisma migrate
# takes advisory locks that PgBouncer's transaction pooling cannot hold. Locally
# there is no pooler, so both point at the same Postgres.
DATABASE_URL=postgresql://dentalops:dentalops@localhost:5432/dentalops
DIRECT_URL=postgresql://dentalops:dentalops@localhost:5432/dentalops
MONGODB_URL=mongodb://localhost:27017/dentalops
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173
SENTRY_DSN=
VITE_API_URL=http://localhost:3001
VITE_SENTRY_DSN=
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SMTP_URL=smtp://localhost:1026
MAIL_FROM=DentalOps <bookings@dentalops.local>

# Read by the container's entrypoint and by main.ts. Compose and `pnpm dev` do
# not need them: migrations run through `pnpm --filter @dentalops/api db:deploy`
# locally, and the API docs are served outside production regardless.
RUN_MIGRATIONS=true
RUN_DEMO_SEED=false
EXPOSE_API_DOCS=true
